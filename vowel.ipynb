    "ch = input(\"Enter any character : \")\n",
    "match ch:\n",
    "    case \"a\" | \"e\" | \"i\" | \"o\" | \"u\" | \"A\" | \"E\" | \"I\" | \"O\" | \"U\":\n",
    "        print(\"character is vowel\")\n",
    "    case _:\n",
    "        print(\"caracter is not an vowel\")"
