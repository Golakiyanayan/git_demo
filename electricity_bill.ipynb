   "source": [
    "unit=int(input(\"enter used unit\"))\n",
    "if unit<100:\n",
    "    print(\"your bill is zero\")\n",
    "elif unit<=200 and unit>=100:\n",
    "    x = unit-100\n",
    "    bill = x*5\n",
    "    print(\"your bill is \", bill)\n",
    "elif unit>200:\n",
    "    n = unit-200\n",
    "    fb = ((unit-200)*10) + (unit-100-n)*5\n",
    "    print(\"your final bill is: \", fb)"
   ]
